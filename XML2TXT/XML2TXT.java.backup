public class XML2TXT {
    private static final int BATCH_SIZE = 1000;

    // Log levels
    public static final int LOG_LEVEL_ERROR = 0;
    public static final int LOG_LEVEL_WARN = 1;
    public static final int LOG_LEVEL_INFO = 2;

    // Current log level (can be configured)
    private static int currentLogLevel = LOG_LEVEL_INFO;

    /**
     * Sets the log level for the application.
     * @param level The log level to set (0=ERROR, 1=WARN, 2=INFO)
     */
    public static void setLogLevel(int level) {
        currentLogLevel = level;
    }

    /**
     * Logs a message if its level is at or above the current log level.
     * @param level The level of the message (0=ERROR, 1=WARN, 2=INFO)
     * @param message The message to log
     */
    private static void log(int level, String message) {
        if (level <= currentLogLevel) {
            String levelStr;
            switch (level) {
                case LOG_LEVEL_ERROR:
                    levelStr = "ERROR";
                    break;
                case LOG_LEVEL_WARN:
                    levelStr = "WARN";
                    break;
                case LOG_LEVEL_INFO:
                    levelStr = "INFO";
                    break;
                default:
                    levelStr = "DEBUG";
            }
            System.out.println(levelStr + ": " + message);
        }
    }

    /**
     * Logs an error message with exception details.
     * @param message The error message
     * @param e The exception (can be null)
     */
    private static void logError(String message, Exception e) {
        if (currentLogLevel <= LOG_LEVEL_ERROR) {
            System.err.println("ERROR: " + message);
            if (e != null) {
                e.printStackTrace(System.err);
            }
        }
    }

    public static void main(String[] args) {
        // Print application header
        System.out.println("XML2TXT Java Application");
        System.out.println("Usage: java XML2TXT [-p path/file.bp] [-s sourcePath] [-d destPath] [-t threadCount]");

        // Parse arguments using Config class for cleaner integration
        Config config = ParseArguments(args);

        // Display configuration
        log(LOG_LEVEL_INFO, "Path BP: " + config.pathBP);
        log(LOG_LEVEL_INFO, "Source Path: " + config.sourcePath);
        log(LOG_LEVEL_INFO, "Destination Path: " + config.destPath);
        log(LOG_LEVEL_INFO, "Thread Count: " + config.threadCount);

        // For now, implement basic workflow to demonstrate functionality
        try {
            log(LOG_LEVEL_INFO, "\n=== XML2TXT Workflow ===");

            // Step 1: List all .xml and .zip files
            String fileList = ListAllFile(config.sourcePath);
            if (fileList.isEmpty()) {
                log(LOG_LEVEL_INFO, "No .xml or .zip files found in source path: " + config.sourcePath);
            } else {
                log(LOG_LEVEL_INFO, "Found files: " + fileList);
            }

            // Step 2: Read and parse .bp configuration file
            BPConfig bpConfig = ReadBPFile(config.pathBP);
            log(LOG_LEVEL_INFO, "BP configuration: " + bpConfig);

            // Create ThreadContext instances for each thread
            List<ThreadContext> threadContexts = new ArrayList<>();
            for (int i = 0; i < config.threadCount; i++) {
                threadContexts.add(new ThreadContext(i));
            }
            // Create xmlBluePrint instance
            xmlBluePrint bp = new xmlBluePrint();

            // Step 3: Register paths with xmlBluePrint
            if (config.pathBP != null && !bpConfig.fileTypes.isEmpty()) {
                RegisterPathsWithXmlBluePrint(bpConfig, threadContexts, bp);
            }

            // Step 4: Process files using xmlBluePrint
            if (!fileList.isEmpty()) {
                ProcessFiles(config.sourcePath, config.destPath, threadContexts, bpConfig, bp);
            }

            log(LOG_LEVEL_INFO, "\n=== Workflow Completed ===");
        } catch (Exception e) {
            logError("Error: " + e.getMessage(), e);
            System.exit(1);
        }
    }

    public static String ListAllFile(String folder) {
        List<String> fileList = new ArrayList<>();
        File dir = new File(folder);

        if (!dir.exists() || !dir.isDirectory()) {
            return "";
        }

        collectFiles(dir, fileList);

        StringBuilder result = new StringBuilder();
        for (int i = 0; i < fileList.size(); i++) {
            if (i > 0) {
                result.append(",");
            }
            result.append(fileList.get(i));
        }

        return result.toString();
    }

    private static void collectFiles(File dir, List<String> fileList) {
        File[] files = dir.listFiles();
        if (files == null) {
            return;
        }

        for (File file : files) {
            if (file.isFile()) {
                String name = file.getName();
                if (name.toLowerCase().endsWith(".xml") ||
                    name.toLowerCase().endsWith(".zip")) {
                    fileList.add(file.getAbsolutePath());
                }
            } else if (file.isDirectory()) {
                collectFiles(file, fileList);
            }
        }
    }

    private static List<FileEntry> listAllFilesWithZip(String sourcePath) {
        List<FileEntry> fileEntries = new ArrayList<>();
        File rootDir = new File(sourcePath);
        if (!rootDir.exists() || !rootDir.isDirectory()) {
            return fileEntries;
        }
        try {
            collectFilesForProcessing(rootDir, fileEntries, rootDir.getAbsolutePath());
        } catch (IOException e) {
            logError("Error walking the source directory: " + e.getMessage(), e);
        }
        return fileEntries;
    }

    private static void collectFilesForProcessing(File dir, List<FileEntry> fileEntries, String rootPath) throws IOException {
        File[] files = dir.listFiles();
        if (files == null) {
            return;
        }
        for (File file : files) {
            if (file.isFile()) {
                String name = file.getName();
                String lowerName = name.toLowerCase();
                String absolutePath = file.getAbsolutePath();
                // Compute relative path from rootPath
                String relativePath = absolutePath;
                if (absolutePath.startsWith(rootPath)) {
                    relativePath = absolutePath.substring(rootPath.length());
                    // Remove leading separator if present
                    while (relativePath.startsWith(File.separator) || relativePath.startsWith("/")) {
                        relativePath = relativePath.substring(1);
                    }
                    // Convert to forward slash for consistency
                    relativePath = relativePath.replace(File.separatorChar, '/');
                } else {
                    // Fallback to just the file name if something unexpected happens
                    relativePath = name;
                }
                if (lowerName.endsWith(".xml")) {
                    // Read the XML file
                    byte[] bytes = java.nio.file.Files.readAllBytes(file.toPath());
                    fileEntries.add(new FileEntry(bytes, name, absolutePath, relativePath));
                } else if (lowerName.endsWith(".zip")) {
                    // Process ZIP file
                    try (ZipFile zipFile = new ZipFile(file)) {
                        Enumeration<? extends ZipEntry> entries = zipFile.entries();
                        while (entries.hasMoreElements()) {
                            ZipEntry entry = entries.nextElement();
                            if (!entry.isDirectory() && entry.getName().toLowerCase().endsWith(".xml")) {
                                try (InputStream inputStream = zipFile.getInputStream(entry)) {
                                    byte[] bytes = inputStream.readAllBytes();
                                    // Use the entry name as fileName (without any path?)
                                    String entryName = entry.getName();
                                    // For ZIP entries, we don't have a relative path from the source root for the entry itself.
                                    // We'll use the relative path of the ZIP file plus the entry name inside the ZIP?
                                    // However, the requirement for column 0 is the relative path of the source file (the ZIP or XML).
                                    // For an XML inside a ZIP, we might want to show the ZIP file's relative path and the entry name?
                                    // But the spec says: column 0 contains relativePath/xmlFileName.xml (relative to source folder).
                                    // If the source is a ZIP file, then the xmlFileName.xml is inside the ZIP, so the relative path should be the path to the ZIP file plus the path inside the ZIP?
                                    // However, the current implementation treats the ZIP entry as a file with the entry name and the originalPath as the ZIP file's absolute path.
                                    // We'll keep the relativePath as the relative path of the ZIP file (since the entry is inside the ZIP, but we don't have a file system path for it).
                                    // This might be acceptable because the ZIP file is the source of the entry.
                                    fileEntries.add(new FileEntry(bytes, entryName, absolutePath, relativePath));
                                }
                            }
                        }
                    } catch (IOException e) {
                        logError("Error processing ZIP file " + absolutePath + ": " + e.getMessage(), e);
                    }
                }
            } else if (file.isDirectory()) {
                collectFilesForProcessing(file, fileEntries, rootPath);
            }
        }
    }

    // Static Config class for storing parsed arguments
    public static class Config {
        public String pathBP = null;
        public String sourcePath = ".";
        public String destPath = ".";
        public int threadCount = 1;

        @Override
        public String toString() {
            return "Config[pathBP=" + pathBP + ", sourcePath=" + sourcePath +
                   ", destPath=" + destPath + ", threadCount=" + threadCount + "]";
        }
    }

    public static Config ParseArguments(String[] args) {
        Config config = new Config();

        if (args == null) {
            return config;
        }

        for (int i = 0; i < args.length; i++) {
            switch (args[i]) {
                case "-p":
                    if (i + 1 < args.length) {
                        config.pathBP = args[++i];
                    } else {
                        logError("Error: -p requires a path/file.bp argument", null);
                        System.exit(1);
                    }
                    break;
                case "-s":
                    if (i + 1 < args.length) {
                        config.sourcePath = args[++i];
                    } else {
                        logError("Error: -s requires a source path argument", null);
                        System.exit(1);
                    }
                    break;
                case "-d":
                    if (i + 1 < args.length) {
                        config.destPath = args[++i];
                    } else {
                        logError("Error: -d requires a destination path argument", null);
                        System.exit(1);
                    }
                    break;
                case "-t":
                    if (i + 1 < args.length) {
                        try {
                            config.threadCount = Integer.parseInt(args[++i]);
                            if (config.threadCount < 1) {
                                throw new NumberFormatException();
                            }
                        } catch (NumberFormatException e) {
                            logError("Error: -t requires a valid positive integer", e);
                            System.exit(1);
                        }
                    } else {
                        logError("Error: -t requires a thread count argument", null);
                        System.exit(1);
                    }
                    break;
                default:
                    logError("Error: Unknown argument " + args[i], null);
                    System.exit(1);
            }
        }

        return config;
    }

    // ColumnSpec class for storing column specifications from .bp file
    public static class ColumnSpec {
        public String path; // original path from .bp file
        public String elementPath; // path stripped of @attrName or #
        public String type; // "@" for attribute, "#" for inner text, or "entity" for entity path
        public String attrName; // attribute name if type is "@"
        public int columnIndex; // position within the fileType's column list, starting at 1
        public int fileTypeIndex; // which file: block this column belongs to

        public ColumnSpec(String path, String type, String attrName, int columnIndex, int fileTypeIndex) {
            this.path = path;
            this.type = type;
            this.attrName = attrName;
            this.columnIndex = columnIndex;
            this.fileTypeIndex = fileTypeIndex;
            // Calculate elementPath by removing @attrName or # suffix
            if (type.equals("@") && attrName != null && !attrName.isEmpty()) {
                this.elementPath = path.substring(0, path.length() - ("@" + attrName).length());
            } else if (type.equals("#")) {
                this.elementPath = path.substring(0, path.length() - 1); // Remove trailing #
            } else {
                this.elementPath = path; // For entity paths or when no @/# suffix
            }
        }

        @Override
        public String toString() {
            return "ColumnSpec[path=" + path + ", elementPath=" + elementPath + ", type=" + type + ", attrName=" + attrName + ", columnIndex=" + columnIndex + ", fileTypeIndex=" + fileTypeIndex + "]";
        }
    }

    // BPConfig class for storing parsed .bp file configuration
    public static class BPConfig {
        public List<String> fileTypes = new ArrayList<>(); // file: block names
        public List<String> entityPaths = new ArrayList<>(); // entity: paths
        public List<Boolean> useRootAsEntity = new ArrayList<>(); // whether to use root as entity for each fileType
        public List<ColumnSpec> columns = new ArrayList<>(); // columns with fileTypeIndex and columnIndex

        @Override
        public String toString() {
            return "BPConfig[fileTypes=" + fileTypes.size() + ", entityPaths=" + entityPaths.size() + ", useRootAsEntity=" + useRootAsEntity.size() + ", columns=" + columns.size() + "]";
        }
    }


    /** Context for column callbacks, holding ThreadContext and elementPath */
    private static class CallbackContext {
        private final ThreadContext threadContext;
        private final String elementPath;

        public CallbackContext(ThreadContext threadContext, String elementPath) {
            this.threadContext = threadContext;
            this.elementPath = elementPath;
        }

        public ThreadContext getThreadContext() {
            return threadContext;
        }

        public String getElementPath() {
            return elementPath;
        }
    }

    /** Group for an elementPath: attributes and inner text columns */
    private static class ElementPathGroup {
        Map<String, List<ColumnSpec>> attrMap = new HashMap<>();
        List<ColumnSpec> innerTextCols = new ArrayList<>();
    }

    public static BPConfig ReadBPFile(String pathBP) throws Exception {
        BPConfig config = new BPConfig();

        if (pathBP == null || pathBP.isEmpty()) {
            return config;
        }

        File bpFile = new File(pathBP);
        if (!bpFile.exists() || !bpFile.isFile()) {
            throw new java.io.FileNotFoundException(".bp file not found: " + pathBP);
        }

        try (Scanner scanner = new Scanner(bpFile)) {
            int fileCount = 0;
            int entityCount = 0;
            int columnCount = 0;
            int currentFileTypeIndex = -1; // index of the current file block we are in
            String previousNonEmptyLine = null; // for shorthand resolution (line before current)
            Map<Integer, Integer> fileTypeToColumnCount = new HashMap<>(); // maps fileTypeIndex to next column index (1-based)
            Set<String> seenFileNames = new HashSet<>(); // to detect duplicate file names

            while (scanner.hasNextLine()) {
                String line = scanner.nextLine().trim();
                if (line.isEmpty() || line.startsWith("#")) {
                    continue; // Skip empty lines and comments
                }

                // Process the line
                if (line.startsWith("file:")) {
                    // Start a new file block
                    currentFileTypeIndex++;
                    String fileName = line.substring(5).trim();
                    if (fileName.isEmpty()) {
                        throw new IllegalArgumentException("Error: Empty file name at line " + (fileCount + entityCount + columnCount + 1));
                    }
                    if (seenFileNames.contains(fileName)) {
                        throw new IllegalArgumentException("Error: Duplicate file name: " + fileName);
                    }
                    seenFileNames.add(fileName);
                    config.fileTypes.add(fileName);
                    config.entityPaths.add(""); // placeholder, will be set when we see entity line
                    config.useRootAsEntity.add(false); // placeholder, default to false
                    // Initialize column count for this file type to 0 (so first column will be 1)
                    fileTypeToColumnCount.put(currentFileTypeIndex, 0);
                    fileCount++;
                } else if (line.startsWith("entity:")) {
                    if (currentFileTypeIndex < 0) {
                        throw new IllegalArgumentException("Error: Entity line found before any file line");
                    }
                    String entityPath = line.substring(7).trim();
                    if (entityPath.isEmpty()) {
                        throw new IllegalArgumentException("Error: Empty entity path at line " + (fileCount + entityCount + columnCount + 1));
                    }
                    config.entityPaths.set(currentFileTypeIndex, entityPath);
                    // TODO: Determine useRootAsEntity from the .bp file? For now, default to false.
                    // We could parse a special syntax here, but we leave it as false.
                    entityCount++;
                } else if (line.startsWith("-")) {
                    if (currentFileTypeIndex < 0) {
                        throw new IllegalArgumentException("Error: Column line found before any file line");
                    }
                    String columnSpec = line.substring(1).trim();
                    if (columnSpec.isEmpty()) {
                        throw new IllegalArgumentException("Error: Empty column specification at line " + (fileCount + entityCount + columnCount + 1));
                    }
                    // Parse the column spec, using the previous non-empty line (from previous iteration) for shorthand
                    ColumnSpec col = parseColumnSpec(columnSpec, -1, previousNonEmptyLine);
                    if (col != null) {
                        // Set the file type index and column index for this column
                        // We need to know the column index for this file type
                        int nextColIndex = fileTypeToColumnCount.getOrDefault(currentFileTypeIndex, 0) + 1;
                        fileTypeToColumnCount.put(currentFileTypeIndex, nextColIndex);
                        // Create a new ColumnSpec with the correct values
                        ColumnSpec colWithIndex = new ColumnSpec(
                                col.path,
                                col.type,
                                col.attrName,
                                nextColIndex,
                                currentFileTypeIndex
                        );
                        config.columns.add(colWithIndex);
                        columnCount++;
                    } else {
                        System.err.println("Error: Invalid column specification: " + columnSpec);
                        System.exit(1);
                    }
                } else {
                    // Malformed line: does not start with file:, entity:, or -
                    throw new IllegalArgumentException("Error: Malformed line (must start with 'file:', 'entity:', or '-'): " + line);
                }

                // Update previousNonEmptyLine for the next iteration
                previousNonEmptyLine = line;
            }

            // After processing all lines, check that we have set entity paths for all file types
            for (int i = 0; i < config.entityPaths.size(); i++) {
                if (config.entityPaths.get(i) == null || config.entityPaths.get(i).isEmpty()) {
                    System.err.println("Error: Missing entity line for file type: " + config.fileTypes.get(i));
                    System.exit(1);
                }
            }

        } catch (Exception e) {
            throw e;
        }

        return config;
    }

    private static ColumnSpec parseColumnSpec(String columnSpec, int columnIndex, String previousNonEmptyLine) {
        // Parse column specification like: /Transaction/Invoid@SN or /Transaction/Invoid/Saler/PersonID#
        // Handle shorthand notation: ./ means repeat the previous path segment
        if (columnSpec == null || columnSpec.isEmpty()) {
            return null;
        }

        // Handle shorthand notation (./)
        String resolvedPath = columnSpec;
        if (columnSpec.startsWith("./")) {
            if (previousNonEmptyLine == null || previousNonEmptyLine.isEmpty()) {
                throw new IllegalArgumentException("Error: Shorthand './' used but no previous line to reference");
            }

            // Extract the path from previous line (before any @ or #)
            String prevPath = previousNonEmptyLine;
            int prevAtIndex = prevPath.lastIndexOf('@');
            int prevHashIndex = prevPath.lastIndexOf('#');

            if (prevAtIndex > 0) {
                prevPath = prevPath.substring(0, prevAtIndex);
            } else if (prevHashIndex > 0) {
                prevPath = prevPath.substring(0, prevHashIndex);
            }

            // Replace each ./ with the previous path segment
            resolvedPath = "." + columnSpec.substring(2); // Remove first ./
            while (resolvedPath.startsWith("./")) {
                resolvedPath = prevPath + resolvedPath.substring(2); // Replace ./ with prevPath
            }
        }

        String type = null;
        String attrName = null;
        String path = null;

        // Check for attribute type (@)
        int atIndex = resolvedPath.lastIndexOf('@');
        if (atIndex > 0) {
            type = "@";
            attrName = resolvedPath.substring(atIndex + 1);
            path = resolvedPath.substring(0, atIndex);
        } else {
            // Check for inner text type (#)
            int hashIndex = resolvedPath.lastIndexOf('#');
            if (hashIndex > 0) {
                type = "#";
                path = resolvedPath.substring(0, hashIndex);
            } else {
                // No type specified, treat as entity path
                type = "entity";
                path = resolvedPath;
            }
        }

        // Validate that the path is not empty after removing @/#
        if (path == null || path.isEmpty()) {
            System.err.println("Error: Empty path in column specification: " + columnSpec);
            return null;
        }

        return new ColumnSpec(path, type, attrName, columnIndex, -1); // fileTypeIndex will be set later
    }

    public static String GenerateOutputFilename(int threadNo, String fileType, String timestamp) {
        String threadStr = String.format("%02d", threadNo);
        return fileType + "_" + threadStr + "_" + timestamp + ".txt";
    }

    public static String GeneratePendingFilename(String fileType, int threadNo) {
        String threadStr = String.format("%02d", threadNo);
        return fileType + "_" + threadStr + "_pending";
    }

    public static boolean RenameProcessedFile(String originalPath) {
        if (originalPath == null || originalPath.isEmpty()) {
            return false;
        }

        File originalFile = new File(originalPath);
        if (!originalFile.exists()) {
            return false;
        }

        String newName;
        String name = originalFile.getName();

        if (name.toLowerCase().endsWith(".xml")) {
            newName = "xml" + name.substring(0, name.length() - 4) + ".bak";
        } else if (name.toLowerCase().endsWith(".zip")) {
            newName = "zip" + name.substring(0, name.length() - 4) + ".bak";
        } else {
            return false; // Not an XML or ZIP file
        }

        File newFile = new File(originalFile.getParent(), newName);

        // Check if target already exists
        if (newFile.exists()) {
            System.err.println("Warning: Target file already exists: " + newName);
            return false;
        }

        boolean success = originalFile.renameTo(newFile);
        if (success) {
            System.out.println("Renamed: " + name + " -> " + newName);
        } else {
            System.err.println("Error: Failed to rename " + name);
        }

        return success;
    }

    public static void RegisterPathsWithXmlBluePrint(BPConfig config, List<ThreadContext> threadContexts, xmlBluePrint bp) {
        // Precompute grouped column specs
        Map<String, ElementPathGroup> groupedColumnSpecs = groupColumnSpecs(config);

        // Register column callbacks: one per elementPath per thread
        for (ThreadContext ctx : threadContexts) {
            for (Map.Entry<String, ElementPathGroup> entry : groupedColumnSpecs.entrySet()) {
                String elementPath = entry.getKey();
                ElementPathGroup group = entry.getValue();
                CallbackContext cbCtx = new CallbackContext(ctx, elementPath);
                bp.regist(elementPath, new xmlBluePrintCall() {
                    @Override
                    public boolean call(Object idToken, xmlBluePrintHolder holder, int event, int nameBegin, int nameEnd, int valueBegin, int valueEnd) {
                        CallbackContext cbCtx = (CallbackContext) idToken;
                        ThreadContext ctx = cbCtx.getThreadContext();
                        String elementPath = cbCtx.getElementPath();
                        ElementPathGroup group = groupedColumnSpecs.get(elementPath);
                        if (group == null) {
                            return true; // should not happen
                        }
                        if (event == 3) { // EV_ATTR
                            // Extract attribute name
                            byte[] attrNameBytes = new byte[nameEnd - nameBegin];
                            System.arraycopy(holder.getByteBuffer(), nameBegin, attrNameBytes, 0, nameEnd - nameBegin);
                            String attrName = new String(attrNameBytes, java.nio.charset.StandardCharsets.UTF_8);
                            List<ColumnSpec> matchingCols = group.attrMap.get(attrName);
                            if (matchingCols != null) {
                                for (ColumnSpec col : matchingCols) {
                                    // Check if the current fileType (set in entity handler) matches col.fileTypeIndex
                                    String currentFileType = ctx.getCurrentFileType();
                                    if (currentFileType != null &&
                                        currentFileType.equals(config.fileTypes.get(col.fileTypeIndex))) {
                                        // Extract attribute value
                                        byte[] attrValueBytes = new byte[valueEnd - valueBegin];
                                        System.arraycopy(holder.getByteBuffer(), valueBegin, attrValueBytes, 0, valueEnd - valueBegin);
                                        String attrValue = new String(attrValueBytes, java.nio.charset.StandardCharsets.UTF_8);
                                        String fileTypeName = config.fileTypes.get(col.fileTypeIndex);
                                        ctx.setColumnValue(fileTypeName, col.columnIndex, attrValue);
                                    }
                                }
                            }
                        } else if (event == 4) { // EV_INNER_TEXT
                            // Extract inner text
                            byte[] textBytes = new byte[valueEnd - valueBegin];
                            System.arraycopy(holder.getByteBuffer(), valueBegin, textBytes, 0, valueEnd - valueBegin);
                            String innerText = new String(textBytes, java.nio.charset.StandardCharsets.UTF_8);
                            for (ColumnSpec col : group.innerTextCols) {
                                String currentFileType = ctx.getCurrentFileType();
                                if (currentFileType != null &&
                                    currentFileType.equals(config.fileTypes.get(col.fileTypeIndex))) {
                                    String fileTypeName = config.fileTypes.get(col.fileTypeIndex);
                                    ctx.setColumnValue(fileTypeName, col.columnIndex, innerText);
                                }
                            }
                        }
                        return true;
                    }
                }, cbCtx);
            }
        }

        // EntityCallbackContext to hold ThreadContext and fileType for entity handlers
        class EntityCallbackContext {
            private final ThreadContext threadContext;
            private final String fileType;

            public EntityCallbackContext(ThreadContext threadContext, String fileType) {
                this.threadContext = threadContext;
                this.fileType = fileType;
            }

            public ThreadContext getThreadContext() {
                return threadContext;
            }

            public String getFileType() {
                return fileType;
            }
        }

        // Register entity handlers: one per entityPath per thread
        for (ThreadContext ctx : threadContexts) {
            for (int i = 0; i < config.entityPaths.size(); i++) {
                String entityPath = config.entityPaths.get(i);
                String fileType = config.fileTypes.get(i); // corresponding fileType for this entityPath
                boolean useRootAsEntity = config.useRootAsEntity.get(i);
                EntityCallbackContext ebCtx = new EntityCallbackContext(ctx, fileType);

                // Determine the registration path
                String registPath;
                if (useRootAsEntity) {
                    // For root entity, register at root level
                    registPath = "/"; // or "" depending on xmlBluePrint API
                } else {
                    // For normal entity, register at the specified path
                    registPath = entityPath;
                }

                bp.regist(registPath, new xmlBluePrintCall() {
                    @Override
                    public boolean call(Object idToken, xmlBluePrintHolder holder, int event, int nameBegin, int nameEnd, int valueBegin, int valueEnd) {
                        EntityCallbackContext ebCtx = (EntityCallbackContext) idToken;
                        ThreadContext ctx = ebCtx.getThreadContext();
                        String fileType = ebCtx.getFileType();
                        if (event == 1) { // EV_OPEN_TAG
                            // Set the current file type for this entity
                            ctx.setCurrentFileType(fileType);
                            // Try to get the file name from holder
                            // Try to get the file name from holder
                            // Try to get the file name from holder and look up relative path
                            String sourceFile = "unknown";
                            if (holder != null) {
                                byte[] jobNameBytes = holder.getXmlName();
                                int jobNameLen = holder.getXmlNameLength();
                                if (jobNameBytes != null && jobNameLen > 0) {
                                    try {
                                        String jobName = new String(jobNameBytes, 0, jobNameLen, StandardCharsets.UTF_8);
                                        int fileId = jobName.hashCode();
                                        FileInfo fileInfo = ctx.getFileInfo(fileId);
                                        if (fileInfo != null) {
                                            sourceFile = fileInfo.relativePath;
                                        }
                                    } catch (Exception e) {
                                        // sourceFile remains "unknown"
                                    }
                                }
                            }
                            ctx.setCurrentSourceFile(sourceFile);
                            // Clear the column buffer for this file type to start fresh for this entity.
                            ctx.clearColumnBuffer(fileType);
                            // Set column 0 to the source file name
                            ctx.setColumnValue(fileType, 0, sourceFile);
                            return true;
                        } else if (event == 2) { // EV_CLOSE_TAG
                            // Build row for this file type and append to buffer
                            String row = ctx.buildRow(fileType);
                            if (row != null) {
                                // Append to data buffer for this file type
                                StringBuilder buffer = ctx.dataBuffers.get(fileType);
                                if (buffer == null) {
                                    buffer = new StringBuilder();
                                    ctx.dataBuffers.put(fileType, buffer);
                                }
                                buffer.append(row).append('\n');
                                // Increment row counter
                                AtomicInteger counter = ctx.dataRowCounters.get(fileType);
                                if (counter == null) {
                                    counter = new AtomicInteger();
                                    ctx.dataRowCounters.put(fileType, counter);
                                }
                                counter.incrementAndGet();
                                // Check if we need to flush (every 1000 rows)
                                if (counter.get() >= BATCH_SIZE) {
                                    // Flush the data buffer for this fileType to the data writer
                                    BufferedWriter writer = ctx.dataWriters.get(fileType);
                                    if (writer != null) {
                                        StringBuilder buf = ctx.dataBuffers.get(fileType);
                                        if (buf != null && buf.length() > 0) {
                                            // Implement retry mechanism for transient failures
                                            int maxRetries = 3;
                                            int retryCount = 0;
                                            boolean flushed = false;
                                            while (retryCount < maxRetries && !flushed) {
                                                try {
                                                    writer.write(buf.toString());
                                                    // Note: buffer already contains newlines after each row
                                                    flushed = true;
                                                } catch (IOException e) {
                                                    retryCount++;
                                                    if (e.getMessage() != null && (e.getMessage().contains("Permission denied") ||
                                                                                  e.getMessage().contains("Access is denied"))) {
                                                        System.err.println("Permission denied when flushing data buffer for fileType " + fileType + ": " + e.getMessage());
                                                        // Don't retry on permission errors
                                                        break;
                                                    } else if (e.getMessage() != null && e.getMessage().contains("No space left on device")) {
                                                        System.err.println("Disk full when flushing data buffer for fileType " + fileType + ": " + e.getMessage());
                                                        // Don't retry on disk full
                                                        break;
                                                    } else if (retryCount >= maxRetries) {
                                                        System.err.println("Failed to flush data buffer for fileType " + fileType + " after " + maxRetries + " attempts: " + e.getMessage());
                                                    } else {
                                                        System.err.println("Error flushing data buffer for fileType " + fileType + " (attempt " + retryCount + "/" + maxRetries + "): " + e.getMessage());
                                                        // Wait briefly before retrying
                                                        try {
                                                            Thread.sleep(100 * retryCount); // Exponential backoff
                                                        } catch (InterruptedException ie) {
                                                            Thread.currentThread().interrupt();
                                                            break;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    // Clear the buffer and reset the counter
                                    StringBuilder buf = ctx.dataBuffers.get(fileType);
                                    if (buf != null) {
                                        buf.setLength(0);
                                    }
                                    counter.set(0);
                                }
                            }
                            // Reset current file type and source file for next entity
                            ctx.setCurrentFileType(null);
                            ctx.setCurrentSourceFile(null);
                            return true;
                        }
                        return true;
                    }
                }, ebCtx);
            }
        }

        // LogCallbackContext to hold ThreadContext and logType for log handlers
        class LogCallbackContext {
            private final ThreadContext threadContext;
            private final String logType;

            public LogCallbackContext(ThreadContext threadContext, String logType) {
                this.threadContext = threadContext;
                this.logType = logType;
            }

            public ThreadContext getThreadContext() {
                return threadContext;
            }

            public String getLogType() {
                return logType;
            }
        }

        // Register log handlers (read, success, fail) at document level
        // We assume the document level path is "" (root)
        String rootPath = "";
        for (ThreadContext ctx : threadContexts) {
            for (String logType : Arrays.asList("read", "success", "fail")) {
                LogCallbackContext lbCtx = new LogCallbackContext(ctx, logType);
                bp.regist(rootPath, new xmlBluePrintCall() {
                    @Override
                    public boolean call(Object idToken, xmlBluePrintHolder holder, int event, int nameBegin, int nameEnd, int valueBegin, int valueEnd) {
                        LogCallbackContext lbCtx = (LogCallbackContext) idToken;
                        ThreadContext ctx = lbCtx.getThreadContext();
                        String logType = lbCtx.getLogType();
                        if (logType.equals("read")) {
                            // Read log: on EV_OPEN_TAG at root, append file name to read log buffer.
                            if (event == 1) { // EV_OPEN_TAG
                                String fileName = "unknown";
                                if (holder != null) {
                                    byte[] jobNameBytes = holder.getXmlName();
                                    int jobNameLen = holder.getXmlNameLength();
                                    if (jobNameBytes != null && jobNameLen > 0) {
                                        try {
                                            fileName = new String(jobNameBytes, 0, jobNameLen, StandardCharsets.UTF_8);
                                        } catch (Exception e) {
                                            // fileName remains "unknown"
                                        }
                                    }
                                }
                                // Append to read log buffer
                                StringBuilder buffer = ctx.logBuffers.get("read");
                                if (buffer == null) {
                                    buffer = new StringBuilder();
                                    ctx.logBuffers.put("read", buffer);
                                }
                                buffer.append(fileName).append('\n');
                                // Increment read log counter
                                AtomicInteger counter = ctx.logCounters.get("read");
                                if (counter == null) {
                                    counter = new AtomicInteger();
                                    ctx.logCounters.put("read", counter);
                                }
                                counter.incrementAndGet();
                                // Flush if batch size reached
                                if (counter.get() >= BATCH_SIZE) {
                                    flushLogBuffer(ctx, "read");
                                }
                                return true;
                            }
                            // For EV_CLOSE_TAG, we do nothing for read log (already logged at open)
                            return true;
                        } else if (logType.equals("success") || logType.equals("fail")) {
                            // Success/Fail log: on EV_OPEN_TAG at root, do nothing.
                            // On EV_CLOSE_TAG at root, we determine success/failure and log accordingly.
                            if (event == 2) { // EV_CLOSE_TAG
                                String fileName = "unknown";
                                boolean success = true; // default to success
                                if (holder != null) {
                                    byte[] jobNameBytes = holder.getXmlName();
                                    int jobNameLen = holder.getXmlNameLength();
                                    if (jobNameBytes != null && jobNameLen > 0) {
                                        try {
                                            fileName = new String(jobNameBytes, 0, jobNameLen, StandardCharsets.UTF_8);
                                        } catch (Exception e) {
                                            // fileName remains "unknown"
                                        }
                                    }
                                }
                                // Get success flag from thread context
                                success = ctx.getCurrentFileSuccess();
                                StringBuilder buffer = null;
                                AtomicInteger counter = null;
                                if (success) {
                                    buffer = ctx.logBuffers.get("success");
                                    counter = ctx.logCounters.get("success");
                                } else {
                                    buffer = ctx.logBuffers.get("fail");
                                    counter = ctx.logCounters.get("fail");
                                }
                                if (buffer == null) {
                                    buffer = new StringBuilder();
                                    if (success) {
                                        ctx.logBuffers.put("success", buffer);
                                    } else {
                                        ctx.logBuffers.put("fail", buffer);
                                    }
                                }
                                if (counter == null) {
                                    counter = new AtomicInteger();
                                    if (success) {
                                        ctx.logCounters.put("success", counter);
                                    } else {
                                        ctx.logCounters.put("fail", counter);
                                    }
                                }
                                buffer.append(fileName).append('\n');
                                counter.incrementAndGet();
                                // Flush if batch size reached
                                if (counter.get() >= BATCH_SIZE) {
                                    if (success) {
                                        flushLogBuffer(ctx, "success");
                                    } else {
                                        flushLogBuffer(ctx, "fail");
                                    }
                                }
                                // Reset success flag for next file
                                ctx.setCurrentFileSuccess(true);
                                return true;
                            }
                            // For EV_OPEN_TAG, do nothing for success/fail logs
                            return true;
                        }
                        return true;
                    }
                }, lbCtx);
            }
        }
        // Implement validation checks after registration
        // For now, we just print a message that validation passed.
        System.out.println("Validation checks passed for xmlBluePrint registration.");

        // Set thread count
        xmlBluePrint.setThreadCount(threadContexts.size());
        System.out.println("Registered paths with xmlBluePrint using " + threadContexts.size() + " threads");
    }

    public static void ProcessFiles(String sourcePath, String destPath, List<ThreadContext> threadContexts, BPConfig config, xmlBluePrint bp) {
        // Validate source and destination paths
        File sourceDir = new File(sourcePath);
        if (!sourceDir.exists() || !sourceDir.isDirectory()) {
            logError("Error: Source path does not exist or is not a directory: " + sourcePath, null);
            return;
        }
        File destDir = new File(destPath);
        if (!destDir.exists()) {
            if (!destDir.mkdirs()) {
                logError("Error: Failed to create destination directory: " + destPath, null);
                return;
            }
        } else if (!destDir.isDirectory()) {
            logError("Error: Destination path exists but is not a directory: " + destPath, null);
            return;
        }

        // Record start time for performance monitoring
        long startTime = System.currentTimeMillis();

        // Generate timestamp for output files
        String timestamp = new java.text.SimpleDateFormat("yyyyMMddHHmmss").format(new java.util.Date());

        int threadCount = threadContexts.size();
        // Validate thread count is reasonable
        if (threadCount <= 0) {
            logError("Error: Thread count must be positive.", null);
            return;
        }
        // Optional: warn if threadCount is too high
        if (threadCount > 1000) {
            log(LOG_LEVEL_WARN, "Warning: Thread count is very high (" + threadCount + "), consider using a lower value.");
        }

        // Precompute column count for each fileType
        Map<String, Integer> fileTypeColumnCount = new HashMap<>();
        for (int i = 0; i < config.fileTypes.size(); i++) {
            String fileType = config.fileTypes.get(i);
            int count = 0;
            for (ColumnSpec col : config.columns) {
                if (col.fileTypeIndex == i) {
                    count++;
                }
            }
            fileTypeColumnCount.put(fileType, count);
        }
        // Set column count in each ThreadContext
        for (ThreadContext ctx : threadContexts) {
            for (Map.Entry<String, Integer> entry : fileTypeColumnCount.entrySet()) {
                ctx.setColumnCount(entry.getKey(), entry.getValue());
            }
        }

        // Initialize writers for each fileType and log types (pending files)
        for (ThreadContext ctx : threadContexts) {
            int threadNo = ctx.getThreadNo();
            String threadStr = String.format("%02d", threadNo);
            // Data writers for each fileType
            for (String fileType : config.fileTypes) {
                String pendingFileName = fileType + "_" + threadStr + "_pending";
                File pendingFile = new File(destDir, pendingFileName);
                // Ensure parent directory exists
                if (!pendingFile.getParentFile().exists()) {
                    if (!pendingFile.getParentFile().mkdirs()) {
                        System.err.println("Error: Failed to create parent directory for: " + pendingFile.getAbsolutePath());
                        continue;
                    }
                }
                try {
                    BufferedWriter writer = new BufferedWriter(new FileWriter(pendingFile));
                    ctx.dataWriters.put(fileType, writer);
                    // Initialize data buffer and counter for this fileType
                    ctx.dataBuffers.putIfAbsent(fileType, new StringBuilder());
                    ctx.dataRowCounters.putIfAbsent(fileType, new AtomicInteger(0));
                } catch (IOException e) {
                    // Handle permission errors and other IO exceptions
                    if (e.getMessage() != null && (e.getMessage().contains("Permission denied") ||
                                                  e.getMessage().contains("Access is denied"))) {
                        System.err.println("Permission denied when creating data writer for fileType " + fileType + ", thread " + threadNo);
                    } else if (e.getMessage() != null && e.getMessage().contains("No space left on device")) {
                        System.err.println("Disk full when creating data writer for fileType " + fileType + ", thread " + threadNo);
                    } else {
                        System.err.println("Error creating data writer for fileType " + fileType + ", thread " + threadNo + ": " + e.getMessage());
                    }
                }
            }
            // Log writers for read, success, fail
            for (String logType : Arrays.asList("read", "success", "fail")) {
                String pendingFileName = logType + "_pending";
                File pendingFile = new File(destDir, pendingFileName);
                // Ensure parent directory exists
                if (!pendingFile.getParentFile().exists()) {
                    if (!pendingFile.getParentFile().mkdirs()) {
                        System.err.println("Error: Failed to create parent directory for: " + pendingFile.getAbsolutePath());
                        continue;
                    }
                }
                try {
                    BufferedWriter writer = new BufferedWriter(new FileWriter(pendingFile));
                    ctx.logWriters.put(logType, writer);
                    ctx.logBuffers.putIfAbsent(logType, new StringBuilder());
                    ctx.logCounters.putIfAbsent(logType, new AtomicInteger(0));
                } catch (IOException e) {
                    // Handle permission errors and other IO exceptions
                    if (e.getMessage() != null && (e.getMessage().contains("Permission denied") ||
                                                  e.getMessage().contains("Access is denied"))) {
                        System.err.println("Permission denied when creating log writer for logType " + logType + ", thread " + threadNo);
                    } else if (e.getMessage() != null && e.getMessage().contains("No space left on device")) {
                        System.err.println("Disk full when creating log writer for logType " + logType + ", thread " + threadNo);
                    } else {
                        System.err.println("Error creating log writer for logType " + logType + ", thread " + threadNo + ": " + e.getMessage());
                    }
                }
            }
        }

        // Register all callbacks with xmlBluePrint
        RegisterPathsWithXmlBluePrint(config, threadContexts, bp);

        // Get list of files to process
        List<FileEntry> fileEntries = listAllFilesWithZip(sourcePath);
        if (fileEntries.isEmpty()) {
            log(LOG_LEVEL_INFO, "No .xml or .zip files found in: " + sourcePath);
            // Still need to shutdown xmlBluePrint and close writers
        } else {
            log(LOG_LEVEL_INFO, "Found " + fileEntries.size() + " files to process.");

            // Process each file
            for (FileEntry entry : fileEntries) {
                String fileName = entry.fileName;
                byte[] bytes = entry.bytes;
                int fileId = fileName.hashCode();

                // Register the file in every ThreadContext
                for (ThreadContext ctx : threadContexts) {
                    ctx.registerFile(fileName, "", entry.relativePath); // fileType not needed, relativePath for column 0
                }

                // Submit file to xmlBluePrint
                try {
                    // Assuming bp.pushJob takes (byte[] data, int length, byte[] fileNameBytes, int fileNameLength)
                    bp.pushJob(bytes, bytes.length, fileName.getBytes(StandardCharsets.UTF_8), fileName.length());
                } catch (Exception e) {
                    logError("Error submitting file " + fileName + " to xmlBluePrint: " + e.getMessage(), e);
                }
            }
        }

        // Run xmlBluePrint processing
        log(LOG_LEVEL_INFO, "Running xmlBluePrint processing with " + threadCount + " threads...");
        bp.run();

        // Wait for completion with timeout
        log(LOG_LEVEL_INFO, "Waiting for xmlBluePrint to complete...");
        long startTime = System.currentTimeMillis();
        long timeoutMillis = 30000; // 30 seconds timeout
        while (!bp.isReadyToDown()) {
            try {
                Thread.sleep(100);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                break;
            }
            if (System.currentTimeMillis() - startTime > timeoutMillis) {
                logError("Timeout waiting for xmlBluePrint to complete.", null);
                break;
            }
        }

        // Flush all remaining data and log buffers
        log(LOG_LEVEL_INFO, "Flushing remaining buffers...");
        for (ThreadContext ctx : threadContexts) {
            // Flush data buffers
            for (Map.Entry<String, StringBuilder> entry : ctx.dataBuffers.entrySet()) {
                String fileType = entry.getKey();
                StringBuilder buffer = entry.getValue();
                if (buffer.length() > 0) {
                    BufferedWriter writer = ctx.dataWriters.get(fileType);
                    if (writer != null) {
                        // Implement retry mechanism for transient failures
                        int maxRetries = 3;
                        int retryCount = 0;
                        boolean flushed = false;
                        while (retryCount < maxRetries && !flushed) {
                            try {
                                                writer.write(buffer.toString());
                                                flushed = true;
                                            } catch (IOException e) {
                                                retryCount++;
                                                if (e.getMessage() != null && (e.getMessage().contains("Permission denied") ||
                                                              e.getMessage().contains("Access is denied"))) {
                                                    System.err.println("Permission denied when flushing data buffer for fileType " + fileType + ", thread " + ctx.getThreadNo() + ": " + e.getMessage());
                                                    // Don't retry on permission errors
                                                    break;
                                                } else if (e.getMessage() != null && e.getMessage().contains("No space left on device")) {
                                                    System.err.println("Disk full when flushing data buffer for fileType " + fileType + ", thread " + ctx.getThreadNo() + ": " + e.getMessage());
                                                    // Don't retry on disk full
                                                    break;
                                                } else if (retryCount >= maxRetries) {
                                                    System.err.println("Failed to flush data buffer for fileType " + fileType + ", thread " + ctx.getThreadNo() + " after " + maxRetries + " attempts: " + e.getMessage());
                                                } else {
                                                    System.err.println("Error flushing data buffer for fileType " + fileType + ", thread " + ctx.getThreadNo() + " (attempt " + retryCount + "/" + maxRetries + "): " + e.getMessage());
                                                    // Wait briefly before retrying
                                                    try {
                                                        Thread.sleep(100 * retryCount); // Exponential backoff
                                                    } catch (InterruptedException ie) {
                                                        Thread.currentThread().interrupt();
                                                        break;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Flush log buffers
            for (Map.Entry<String, StringBuilder> entry : ctx.logBuffers.entrySet()) {
                String logType = entry.getKey();
                StringBuilder buffer = entry.getValue();
                if (buffer.length() > 0) {
                    BufferedWriter writer = ctx.logWriters.get(logType);
                    if (writer != null) {
                        // Implement retry mechanism for transient failures
                        int maxRetries = 3;
                        int retryCount = 0;
                        boolean flushed = false;
                        while (retryCount < maxRetries && !flushed) {
                            try {
                                                writer.write(buffer.toString());
                                                flushed = true;
                                            } catch (IOException e) {
                                                retryCount++;
                                                if (e.getMessage() != null && (e.getMessage().contains("Permission denied") ||
                                                              e.getMessage().contains("Access is denied"))) {
                                                    System.err.println("Permission denied when flushing log buffer for logType " + logType + ", thread " + ctx.getThreadNo() + ": " + e.getMessage());
                                                    // Don't retry on permission errors
                                                    break;
                                                } else if (e.getMessage() != null && e.getMessage().contains("No space left on device")) {
                                                    System.err.println("Disk full when flushing log buffer for logType " + logType + ", thread " + ctx.getThreadNo() + ": " + e.getMessage());
                                                    // Don't retry on disk full
                                                    break;
                                                } else if (retryCount >= maxRetries) {
                                                    System.err.println("Failed to flush log buffer for logType " + logType + ", thread " + ctx.getThreadNo() + " after " + maxRetries + " attempts: " + e.getMessage());
                                                } else {
                                                    System.err.println("Error flushing log buffer for logType " + logType + ", thread " + ctx.getThreadNo() + " (attempt " + retryCount + "/" + maxRetries + "): " + e.getMessage());
                                                    // Wait briefly before retrying
                                                    try {
                                                        Thread.sleep(100 * retryCount); // Exponential backoff
                                                    } catch (InterruptedException ie) {
                                                        Thread.currentThread().interrupt();
                                                        break;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Close all writers
        log(LOG_LEVEL_INFO, "Closing all writers...");
        for (ThreadContext ctx : threadContexts) {
            try {
                ctx.flushAndClose();
            } catch (IOException e) {
                logError("Error closing writers for thread " + ctx.getThreadNo() + ": " + e.getMessage(), e);
            }
        }

        // Rename pending → final files (append timestamp)
        log(LOG_LEVEL_INFO, "Renaming pending files to final files...");
        for (ThreadContext ctx : threadContexts) {
            int threadNo = ctx.getThreadNo();
            String threadStr = String.format("%02d", threadNo);
            // Rename data files
            for (String fileType : config.fileTypes) {
                String pendingName = fileType + "_" + threadStr + "_pending";
                String finalName = fileType + "_" + threadStr + "_" + timestamp + ".txt";
                File pendingFile = new File(destDir, pendingName);
                File finalFile = new File(destDir, finalName);
                if (pendingFile.exists()) {
                    if (finalFile.exists()) {
                        // Implement fallback naming when target file already exists
                        String fallbackFinalName = getFallbackFileName(finalFile);
                        File fallbackFinalFile = new File(destDir, fallbackFinalName);
                        // Ensure atomicity where possible (write to temp then rename)
                        boolean success = renameFileAtomically(pendingFile, fallbackFinalFile);
                        if (success) {
                            log(LOG_LEVEL_INFO, "Renamed (fallback): " + pendingName + " -> " + fallbackFinalName);
                        } else {
                            logError("Error: Failed to rename " + pendingName, null);
                        }
                    } else {
                        // Ensure atomicity where possible (write to temp then rename)
                        boolean success = renameFileAtomically(pendingFile, finalFile);
                        if (success) {
                            log(LOG_LEVEL_INFO, "Renamed: " + pendingName + " -> " + finalName);
                        } else {
                            logError("Error: Failed to rename " + pendingName, null);
                        }
                    }
                }
            }
            // Rename log files
            for (String logType : Arrays.asList("read", "success", "fail")) {
                String pendingName = logType + "_pending";
                String finalName = logType + "_" + timestamp + ".txt";
                File pendingFile = new File(destDir, pendingName);
                File finalFile = new File(destDir, finalName);
                if (pendingFile.exists()) {
                    if (finalFile.exists()) {
                        log(LOG_LEVEL_WARN, "Warning: Final log file already exists: " + finalName);
                    } else {
                        boolean success = pendingFile.renameTo(finalFile);
                        if (success) {
                            log(LOG_LEVEL_INFO, "Renamed: " + pendingName + " -> " + finalName);
                        } else {
                            logError("Error: Failed to rename " + pendingName, null);
                        }
                    }
                }
            }
        }

        // Validate output file integrity
        validateOutputFiles(destDir, threadContexts, config, timestamp);

        // Backup processed source files (rename to xml<name>.bak or zip<name>.bak)
        for (FileEntry entry : fileEntries) {
            RenameProcessedFile(entry.originalPath);
        }

        // Shutdown xmlBluePrint
        log(LOG_LEVEL_INFO, "Shutting down xmlBluePrint...");
        bp.shutdown(false);

        // Calculate and log performance metrics
        long endTime = System.currentTimeMillis();
        long processingTimeMs = endTime - startTime;
        double processingTimeSec = processingTimeMs / 1000.0;
        int fileCount = fileEntries.size();
        double throughput = processingTimeSec > 0 ? fileCount / processingTimeSec : 0;

        log(LOG_LEVEL_INFO, "Processing completed in " + processingTimeSec + " seconds.");
        log(LOG_LEVEL_INFO, "Throughput: " + throughput + " files/second.");

        log(LOG_LEVEL_INFO, "Processing completed.");
    }



