    /**
     * Generates a fallback file name when the target file already exists.
     * @param originalFile The original file
     * @return A fallback file name
     */
    private static String getFallbackFileName(File originalFile) {
        String name = originalFile.getName();
        String parentDir = originalFile.getParent();

        // If it's a .txt file, try adding a counter before the extension
        if (name.toLowerCase().endsWith(".txt")) {
            String baseName = name.substring(0, name.length() - 4);
            int counter = 1;
            String fallbackName;
            File fallbackFile;
            do {
                fallbackName = baseName + "_" + counter + ".txt";
                fallbackFile = new File(parentDir, fallbackName);
                counter++;
            } while (fallbackFile.exists());
            return fallbackName;
        }
        // For other files, just add a counter at the end
        else {
            int counter = 1;
            String fallbackName;
            File fallbackFile;
            do {
                fallbackName = name + "_" + counter;
                fallbackFile = new File(parentDir, fallbackName);
                counter++;
            } while (fallbackFile.exists());
            return fallbackName;
        }
    }

    /**
     * Renames a file atomically where possible by writing to a temp file first.
     * @param sourceFile The source file to rename
     * @param destFile The destination file
     * @return true if successful, false otherwise
     */
    private static boolean renameFileAtomically(File sourceFile, File destFile) {
        try {
            // If the destination file doesn't exist, try a simple rename first
            if (!destFile.exists()) {
                return sourceFile.renameTo(destFile);
            }

            // If the destination file exists, we need to be more careful
            // Create a temporary file in the same directory
            String tempName = destFile.getName() + ".tmp";
            File tempFile = new File(destFile.getParent(), tempName);

            // Copy the source file to the temporary file
            java.nio.file.Files.copy(sourceFile.toPath(), tempFile.toPath());

            // Delete the destination file
            if (!destFile.delete()) {
                // Clean up temp file
                if (tempFile.exists()) {
                    tempFile.delete();
                }
                return false;
            }

            // Rename the temporary file to the destination file
            boolean success = tempFile.renameTo(destFile);

            // Clean up temp file if rename failed
            if (!success && tempFile.exists()) {
                tempFile.delete();
            }

            return success;
        } catch (Exception e) {
            logError("Error in atomic rename: " + e.getMessage(), e);
            return false;
        }
    }

    /**
     * Validates the integrity of output files.
     * @param destDir The destination directory
     * @param threadContexts The list of thread contexts
     * @param config The BP configuration
     * @param timestamp The timestamp used in file names
     */
    private static void validateOutputFiles(File destDir, List<ThreadContext> threadContexts, BPConfig config, String timestamp) {
        log(LOG_LEVEL_INFO, "Validating output file integrity...");

        // Validate data files
        for (ThreadContext ctx : threadContexts) {
            int threadNo = ctx.getThreadNo();
            String threadStr = String.format("%02d", threadNo);

            for (String fileType : config.fileTypes) {
                String finalName = fileType + "_" + threadStr + "_" + timestamp + ".txt";
                File finalFile = new File(destDir, finalName);

                if (finalFile.exists()) {
                    // Check that output files are not empty when data is expected
                    if (finalFile.length() == 0) {
                        log(LOG_LEVEL_WARN, "Warning: Output file is empty: " + finalName);
                    } else {
                        try {
                            validateDataFile(finalFile, fileType, threadNo, timestamp);
                            log(LOG_LEVEL_INFO, "Output file validation passed: " + finalName);
                        } catch (IOException e) {
                            log(LOG_LEVEL_ERROR, "Validation failed for output file " + finalName + ": " + e.getMessage(), e);
                        }
                    }
                }
            }
        }

        // Validate log files
        for (String logType : Arrays.asList("read", "success", "fail")) {
            String finalName = logType + "_" + timestamp + ".txt";
            File finalFile = new File(destDir, finalName);

            if (finalFile.exists()) {
                // Check that output files are not empty when data is expected
                if (finalFile.length() == 0) {
                    log(LOG_LEVEL_WARN, "Warning: Log file is empty: " + finalName);
                } else {
                    try {
                        validateLogFile(finalFile, logType, threadContexts);
                        log(LOG_LEVEL_INFO, "Log file validation passed: " + finalName);
                    } catch (IOException e) {
                        log(LOG_LEVEL_ERROR, "Validation failed for log file " + finalName + ": " + e.getMessage(), e);
                    }
                }
            }
        }
    }

    /**
     * Validates a data output file.
     * @param file The file to validate
     * @param fileType The file type (from .bp file)
     * @param threadNo The thread number
     * @param timestamp The timestamp used in the file name
     * @throws IOException If validation fails
     */
    private static void validateDataFile(File file, String fileType, int threadNo, String timestamp) throws IOException {
        // Expected file name pattern: {fileType}_{thread:02d}_{timestamp}.txt
        String expectedPattern = fileType + "_" + String.format("%02d", threadNo) + "_" + timestamp + ".txt";
        if (!file.getName().equals(expectedPattern)) {
            throw new IOException("File name does not match expected pattern. Expected: " + expectedPattern + ", Got: " + file.getName());
        }

        // Read the file and validate content
        List<String> lines = java.nio.file.Files.readAllLines(file.toPath());
        if (lines.isEmpty()) {
            throw new IOException("File is empty");
        }

        // Validate each line
        for (int i = 0; i < lines.size(); i++) {
            String line = lines.get(i);
            int lineNum = i + 1;

            // Check line ending (should be \n, but readAllLines removes it, so we check if original had \r\n or \n)
            // This is a basic check - we could read as bytes for more precision
            if (line.isEmpty() && i < lines.size() - 1) {
                // Empty lines might be OK depending on content, but let's warn
                log(LOG_LEVEL_WARN, "Empty line found at line " + lineNum + " in file " + file.getName());
            }

            // Check column delimiter (should be tab)
            if (line.contains(",")) {
                throw new IOException("Comma found in line " + lineNum + ". Expected tab-delimited file.");
            }
            if (!line.contains("\t") && line.length() > 0) {
                // Only check for tab if line has content
                throw new IOException("Tab delimiter not found in line " + lineNum + ". Expected tab-delimited file.");
            }

            // Validate column 0 format (should be relativePath/xmlFileName.xml)
            String[] columns = line.split("\t");
            if (columns.length < 1) {
                throw new IOException("Line " + lineNum + " has no columns");
            }

            String column0 = columns[0];
            // Column 0 should not be empty and should contain a file path
            if (column0 == null || column0.isEmpty()) {
                throw new IOException("Column 0 is empty in line " + lineNum);
            }

            // Additional validation: column 0 should look like a file path
            // It should contain at least one slash or dot (file extension)
            if (!column0.contains("/") && !column0.contains("\\") && !column0.contains(".")) {
                log(LOG_LEVEL_WARN, "Column 0 in line " + lineNum + " doesn't look like a file path: " + column0);
            }
        }
    }

    /**
     * Validates a log file.
     * @param file The file to validate
     * @param logType The type of log (read, success, fail)
     * @param threadContexts The list of thread contexts to check counters against
     * @throws IOException If validation fails
     */
    private static void validateLogFile(File file, String logType, List<ThreadContext> threadContexts) throws IOException {
        // Expected file name pattern: {logType}_{timestamp}.txt
        String expectedPattern = logType + "_" + ".*" + ".txt"; // We'll check timestamp separately
        if (!file.getName().matches(logType + "_\\d{14}\\.txt")) {
            throw new IOException("File name does not match expected pattern. Expected: " + logType + "_YYYYMMDDHHMMSS.txt, Got: " + file.getName());
        }

        // Read the file and validate content
        List<String> lines = java.nio.file.Files.readAllLines(file.toPath());
        if (lines.isEmpty()) {
            throw new IOException("File is empty");
        }

        // Validate each line
        for (int i = 0; i < lines.size(); i++) {
            String line = lines.get(i);
            int lineNum = i + 1;

            // Check for empty lines
            if (line == null || line.isEmpty()) {
                throw new IOException("Empty line found at line " + lineNum + " in file " + file.getName());
            }

            // Log files should contain file names, so they should not be empty after trimming
            if (line.trim().isEmpty()) {
                throw new IOException("Line " + lineNum + " contains only whitespace in file " + file.getName());
            }
        }

        // Verify that the number of lines matches the expected count from thread contexts
        int totalExpected = 0;
        for (ThreadContext ctx : threadContexts) {
            AtomicInteger counter = ctx.logCounters.get(logType);
            if (counter != null) {
                totalExpected += counter.get();
            }
        }

        if (lines.size() != totalExpected) {
            throw new IOException("Log file " + file.getName() + " has " + lines.size() + " lines, but expected " + totalExpected + " lines based on counters");
        }
    }
    // FileInfo class to hold file information
    public static class FileInfo {
        public final String fileName;
        public final String fileType;
        public final String relativePath;

        public FileInfo(String fileName, String fileType, String relativePath) {
            this.fileName = fileName;
            this.fileType = fileType;
            this.relativePath = relativePath;
        }
    }

    // ThreadContext per parser thread
    public static class ThreadContext {
        private final int threadNo;
        // Data file writers and buffers
        private final Map<String, BufferedWriter> dataWriters = new HashMap<>();
        private final Map<String, StringBuilder> dataBuffers = new HashMap<>();
        private final Map<String, AtomicInteger> dataRowCounters = new HashMap<>();
        // Log writers and buffers for read, success, fail
        private final Map<String, BufferedWriter> logWriters = new HashMap<>();
        private final Map<String, StringBuilder> logBuffers = new HashMap<>();
        private final Map<String, AtomicInteger> logCounters = new HashMap<>();
        // Column buffers: fileType -> array of values (index 0 reserved for source file name)
        private final Map<String, String[]> columnBuffers = new HashMap<>();
        // Column counts per fileType (total columns including source file column)
        private final Map<String, Integer> columnCounts = new HashMap<>();
        // Current file type and source file being processed (set by entity handler)
        private String currentFileType;
        private String currentSourceFile;
        private boolean currentFileSuccess = true;
        // File ID map: hash(fileName) -> FileInfo
        private final Map<Integer, FileInfo> fileIdMap = new HashMap<>();

        public ThreadContext(int threadNo) {
            this.threadNo = threadNo;
        }
        public void setCurrentFileSuccess(boolean success) { this.currentFileSuccess = success; }
        public boolean getCurrentFileSuccess() { return this.currentFileSuccess; }

        public int getThreadNo() {
            return threadNo;
        }

        public void registerFile(String fileName, String fileType, String entityPath) {
            int fileId = fileName.hashCode();
            fileIdMap.put(fileId, new FileInfo(fileName, fileType, entityPath));
        }

        public FileInfo getFileInfo(Integer fileId) {
            return fileIdMap.get(fileId);
        }

        public void initColumnBuffer(String fileType) {
            Integer colCount = columnCounts.get(fileType);
            if (colCount == null) {
                colCount = 0;
            }
            // +1 for source file column (index 0)
            String[] buffer = new String[colCount + 1];
            columnBuffers.put(fileType, buffer);
        }

        public void clearColumnBuffer(String fileType) {
            String[] buffer = columnBuffers.get(fileType);
            if (buffer != null) {
                Arrays.fill(buffer, null);
            }
        }

        public void setColumnValue(String fileType, int columnIndex, String value) {
            String[] buffer = columnBuffers.get(fileType);
            if (buffer != null && columnIndex >= 0 && columnIndex < buffer.length) {
                buffer[columnIndex] = value;
            }
        }

        public String buildRow(String fileType) {
            String[] buffer = columnBuffers.get(fileType);
            if (buffer == null) {
                return null;
            }
            StringBuilder rowBuilder = new StringBuilder();
            for (int i = 0; i < buffer.length; i++) {
                if (i > 0) {
                    rowBuilder.append('\t');
                }
                String val = buffer[i];
                rowBuilder.append(val == null ? "" : val);
            }
            return rowBuilder.toString();
        }

        // Methods to get/create data writer for a fileType
        public BufferedWriter getDataWriter(String fileType) throws IOException {
            BufferedWriter writer = dataWriters.get(fileType);
            if (writer == null) {
                // In real implementation, we would create the file here.
                // For now, we'll just return null and let the caller handle it.
                return null;
            }
            return writer;
        }

        // Similarly for log workers
        public BufferedWriter getLogWriter(String logType) throws IOException {
            BufferedWriter writer = logWriters.get(logType);
            if (writer == null) {
                return null;
            }
            return writer;
        }

        // Method to flush all buffers and close writers (to be called at end)
        public void flushAndClose() {
            // Flush and close data writers
            for (BufferedWriter writer : dataWriters.values()) {
                if (writer != null) {
                    try {
                        writer.flush();
                    } catch (IOException e) {
                        System.err.println("Error flushing data writer: " + e.getMessage());
                    }
                    try {
                        writer.close();
                    } catch (IOException e) {
                        System.err.println("Error closing data writer: " + e.getMessage());
                    }
                }
            }
            // Flush and close log writers
            for (BufferedWriter writer : logWriters.values()) {
                if (writer != null) {
                    try {
                        writer.flush();
                    } catch (IOException e) {
                        System.err.println("Error flushing log writer: " + e.getMessage());
                    }
                    try {
                        writer.close();
                    } catch (IOException e) {
                        System.err.println("Error closing log writer: " + e.getMessage());
                    }
                }
            }
        }
        // Getters and setters for currentFileType and currentSourceFile
        public String getCurrentFileType() {
            return currentFileType;
        }

        public void setCurrentFileType(String currentFileType) {
            this.currentFileType = currentFileType;
        }

        public String getCurrentSourceFile() {
            return currentSourceFile;
        }

        public void setCurrentSourceFile(String currentSourceFile) {
            this.currentSourceFile = currentSourceFile;
        }

        // Added for setting column count per fileType
        public void setColumnCount(String fileType, int count) {
            this.columnCounts.put(fileType, count);
        }
    }

    /**
     * Represents a file to be processed, containing its content and metadata.
     */
    private static void flushLogBuffer(ThreadContext ctx, String logType) {
        BufferedWriter writer = ctx.logWriters.get(logType);
        if (writer != null) {
            StringBuilder buffer = ctx.logBuffers.get(logType);
            if (buffer != null && buffer.length() > 0) {
                // Implement retry mechanism for transient failures
                int maxRetries = 3;
                int retryCount = 0;
                boolean flushed = false;
                while (retryCount < maxRetries && !flushed) {
                    try {
                                                    writer.write(buffer.toString());
                                                    flushed = true;
                                                } catch (IOException e) {
                                                    retryCount++;
                                                    if (e.getMessage() != null && (e.getMessage().contains("Permission denied") ||
                                                              e.getMessage().contains("Access is denied"))) {
                                                        System.err.println("Permission denied when flushing log buffer for logType " + logType + ": " + e.getMessage());
                                                        // Don't retry on permission errors
                                                        break;
                                                    } else if (e.getMessage() != null && e.getMessage().contains("No space left on device")) {
                                                        System.err.println("Disk full when flushing log buffer for logType " + logType + ": " + e.getMessage());
                                                        // Don't retry on disk full
                                                        break;
                                                    } else if (retryCount >= maxRetries) {
                                                        System.err.println("Failed to flush log buffer for logType " + logType + " after " + maxRetries + " attempts: " + e.getMessage());
                                                    } else {
                                                        System.err.println("Error flushing log buffer for logType " + logType + " (attempt " + retryCount + "/" + maxRetries + "): " + e.getMessage());
                                                        // Wait briefly before retrying
                                                        try {
                                                            Thread.sleep(100 * retryCount); // Exponential backoff
                                                        } catch (InterruptedException ie) {
                                                            Thread.currentThread().interrupt();
                                                            break;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // Clear the buffer and reset the counter
        StringBuilder buf = ctx.logBuffers.get(logType);
        if (buf != null) {
            buf.setLength(0);
        }
        AtomicInteger counter = ctx.logCounters.get(logType);
        if (counter != null) {
            counter.set(0);
        }
    }
    public static class FileEntry {
        public final byte[] bytes;
        public final String fileName;
        public final String originalPath;
        public final String relativePath; // relative to the source directory

        public FileEntry(byte[] bytes, String fileName, String originalPath, String relativePath) {
            this.bytes = bytes;
            this.fileName = fileName;
            this.originalPath = originalPath;
            this.relativePath = relativePath;
        }
    }
}